---
/*
  ═══════════════════════════════════════════════════════════════
  SAVOI — DIRECTION CONTRACT
  ═══════════════════════════════════════════════════════════════

  THESIS: The site is a set of declassified case files — institutional,
  authoritative, precise. It refuses the AI-category default (dark
  gradients, glowing orbs, three feature cards). Every page is a file.

  OWN-WORLD: Warm paper ground + deep ink sections. Oxblood (#8c2020)
  is the sole accent. Spectral serif for all content, JetBrains Mono for
  all labels/metadata/UI. File header bars, classification stamps,
  redaction bars, margin annotations, document rule lines.

  STORY: Visitor opens a case file and understands Savoi installs
  production-grade AI systems, not chatbots. They see institutional proof,
  then act via a strategy call CTA.

  FIRST VIEWPORT: File header bar (FILE NO / CLASSIFICATION / DATE),
  typed hero headline, classification stamp, primary CTA button.

  FORM: Intelligence dossier / case file. Rank #4 of 7 grounded
  directions. Seed key: 520e6f7f. Staging: scroll-reveal redaction
  (assigned staging rejected as too gimmicky for B2B scanability).
  ═══════════════════════════════════════════════════════════════
*/

import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  fileNo?: string;
  classification?: string;
  date?: string;
  title: string;
  description?: string;
  darkHero?: boolean;
}

const {
  fileNo = 'SAVOI-001',
  classification = 'UNCLASSIFIED',
  date = '2026.07.28',
  title,
  description = 'Managed agents by Savoi. AI employees we build, install in your tools, and run under a management retainer. You stay in control of anything that matters.',
  darkHero = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://savoi.ai" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <Nav />
  <div class="file-header">
    <div class="file-header-item">FILE NO. <strong>{fileNo}</strong></div>
    <div class="file-header-item">DATE <strong>{date}</strong></div>
    <div class="file-header-spacer"></div>
    <div class="file-header-classification">{classification}</div>
  </div>
  <main id="main">
    <slot />
  </main>
  <Footer />

  <script>
    // Scroll reveal for redaction bars and content
    const reveals = document.querySelectorAll('.reveal, .redacted, .stamp-animate');

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

      reveals.forEach((el) => observer.observe(el));
    } else {
      reveals.forEach((el) => el.classList.add('revealed'));
    }
  </script>

  <!-- Start of HubSpot Embed Code -->
  <script is:inline>
    // Skip tracking on localhost/LAN so dev and preview visits don't pollute analytics
    if (!/^(localhost|127\.|192\.168\.)/.test(location.hostname)) {
      const s = document.createElement('script');
      s.id = 'hs-script-loader';
      s.async = true;
      s.defer = true;
      s.src = 'https://js.hs-scripts.com/24211389.js';
      document.head.appendChild(s);
    }
  </script>
  <!-- End of HubSpot Embed Code -->
</body>
</html>
