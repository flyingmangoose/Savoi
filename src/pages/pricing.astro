---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';

const title = 'Pricing — Clear Packages. Real Production Systems. | Savoi.ai';

const packages = [
  {
    num: '01',
    name: 'Starter',
    tagline: '1–2 AI employees + the basics',
    implementation: '$25,000 – $40,000',
    managed: '$2,500 – $4,000 / month',
    features: ['Planning and design', 'Build and setup', 'Connected to your tools', 'You approve anything important', 'Training and documentation'],
  },
  {
    num: '02',
    name: 'Growth',
    tagline: 'AI employees for your whole team',
    implementation: '$60,000 – $90,000',
    managed: '$6,000 – $10,000 / month',
    features: ['Everything in Starter', 'Multiple AI employees working together', 'More tool connections', 'Cost-smart AI routing', 'Tasks that run on their own', 'Optional ongoing support'],
    featured: true,
  },
  {
    num: '03',
    name: 'Enterprise',
    tagline: 'Multiple teams + custom security and private deployment',
    implementation: 'Custom pricing',
    managed: 'Custom pricing',
    features: ['Everything in Growth', 'Custom security review', 'Private deployment options', 'Dedicated team', 'Priority support with SLA'],
  },
];
---

<Base title={title} fileNo="SAVOI-006" classification="FOR PUBLIC RELEASE">
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-meta label">FILE 06 — PRICING</div>
      <h1 class="page-title reveal">Clear Pricing.<br /><span class="page-title-accent">Real AI Employees.</span></h1>
    </div>
  </section>

  <section class="section paper-texture">
    <div class="container">
      <div class="rule-label reveal"><span>§ 01 — AI Employee Packages</span></div>
      <div class="grid grid-3 pricing-grid">
        {packages.map((pkg) => (
          <div class={`pricing-card reveal ${pkg.featured ? 'pricing-featured' : ''}`}>
            {pkg.featured && <div class="pricing-badge">RECOMMENDED</div>}
            <div class="pricing-card-header">
              <span class="pricing-num">PKG {pkg.num}</span>
              <h3 class="pricing-name">{pkg.name}</h3>
            </div>
            <p class="pricing-tagline">{pkg.tagline}</p>
            <hr class="rule" />
            <div class="pricing-price-group">
              <div class="pricing-price-label label">Implementation</div>
              <div class="pricing-price">{pkg.implementation}</div>
            </div>
            <div class="pricing-price-group">
              <div class="pricing-price-label label">Managed service</div>
              <div class="pricing-price-sm">{pkg.managed}</div>
            </div>
            <hr class="rule" />
            <ul class="doc-list pricing-features">
              {pkg.features.map((f) => <li>{f}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="rule-label reveal"><span>§ 02 — Simple Tools</span></div>
      <div class="micro-saas-pricing reveal">
        <p class="msp-text">
          Most of our simple tools run between
          <span class="msp-price">$99 – $999</span>
          a month, depending on what you need.
        </p>
      </div>
    </div>
  </section>

  <CTA
    headline="Not sure which one fits?"
    subtext="Book a call — we'll look at your actual business and tell you honestly what makes sense."
    fileNo="SAVOI-006 / CTA"
  />
</Base>

<style>
  .page-hero { padding: 5rem 0 4rem; }
  .page-meta { color: var(--file-tab); margin-bottom: 1rem; }
  .page-title { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 800; line-height: 1.1; }
  .page-title-accent { color: var(--classification-soft); font-style: italic; font-weight: 600; }

  .pricing-grid { margin-top: 1rem; align-items: start; }
  .pricing-card {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 2rem;
    position: relative;
    transition: border-color 200ms;
  }
  .pricing-card:hover { border-color: var(--rule-2); }
  .pricing-featured {
    border: 2px solid var(--file-tab);
    box-shadow: 0 4px 24px rgba(184,148,90,0.12);
  }
  .pricing-badge {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--file-tab);
    color: var(--ink);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 0.25rem 0.875rem;
    border-radius: var(--radius);
  }
  .pricing-card-header { margin-bottom: 0.625rem; }
  .pricing-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--file-tab);
  }
  .pricing-name { font-size: 1.75rem; font-weight: 700; margin: 0.25rem 0 0; }
  .pricing-tagline { font-size: 0.875rem; color: var(--ink-muted); margin: 0; line-height: 1.4; }
  .pricing-price-group { margin-bottom: 1rem; }
  .pricing-price-label { color: var(--ink-muted); margin-bottom: 0.25rem; }
  .pricing-price { font-size: 1.25rem; font-weight: 700; color: var(--ink); font-family: 'Spectral', serif; }
  .pricing-price-sm { font-size: 0.9375rem; color: var(--ink-soft); font-family: 'Spectral', serif; }
  .pricing-features { margin-top: 0.5rem; }
  .pricing-features li { font-size: 0.875rem; }

  .micro-saas-pricing { max-width: 620px; }
  .msp-text { font-size: 1.25rem; line-height: 1.5; color: var(--paper); }
  .msp-price {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--file-tab);
    padding: 0 0.3rem;
  }

  @media (max-width: 900px) {
    .pricing-grid { grid-template-columns: 1fr; max-width: 480px; margin: 1rem auto 0; }
  }
</style>
