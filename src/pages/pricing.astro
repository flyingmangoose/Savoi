---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';

const title = 'Pricing · Bespoke Builds, Scoped Before They Are Priced | Savoi.ai';
const description = 'Every Savoi engagement follows one ladder: a free AI Working Session, a $1,000 AI Strategy Session credited to the Sprint, a $9,500 two week Build-Ready Sprint credited to the Pilot, a $35,000 Pilot of your bespoke software, then a Run retainer of $2,500 to $4,000 a month.';

const packages = [
  {
    num: '01',
    name: 'Working Session',
    tagline: 'About 90 minutes with you and the people who own the work',
    implementation: 'Free',
    managed: 'No commitment',
    features: ['Walk us through where the time goes', 'A short list of workflows ranked by payback', 'A straight answer on whether AI fits'],
  },
  {
    num: '02',
    name: 'AI Strategy Session',
    tagline: 'One focused hour with an owner-operator, plus a written plan',
    implementation: '$1,000',
    managed: 'Credited to the Sprint if booked within 30 days',
    features: ['A 15 minute intake form before we meet', 'One hour on your business, your numbers and your team', 'A one page AI plan with your top 3 plays within 48 hours'],
  },
  {
    num: '03',
    name: 'Build-Ready Sprint',
    tagline: 'Two weeks on one workflow, ending in a build spec',
    implementation: '$9,500',
    managed: 'Fully credited to the Pilot',
    features: ['We sit with the team that does the work', 'Written requirements for the first version', 'A fixed scope and plan for the Pilot'],
  },
  {
    num: '04',
    name: 'Pilot',
    tagline: 'A thin working system on your real work',
    implementation: '$35,000',
    managed: 'Sprint fee credited',
    features: ['Built to the Sprint spec', 'Connected to the tools you already run', 'You approve anything important', 'You own the code, the harness and the data'],
  },
  {
    num: '05',
    name: 'Run',
    tagline: 'We keep it running and improving',
    implementation: '$2,500 to $4,000 / month',
    managed: 'Monthly retainer',
    features: ['Monitoring, maintenance and model costs', 'A working session every month', 'Scoped next steps quoted before they start'],
  },
];
---

<Base title={title} description={description} fileNo="SAVOI-006" classification="FOR PUBLIC RELEASE">
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-meta label">FILE 06 · PRICING</div>
      <h1 class="page-title reveal">Scoped First.<br /><span class="page-title-accent">Then Priced.</span></h1>
      <p class="page-subtitle reveal">
        Every engagement follows the same ladder. It starts with a free Working Session, then an optional
        one hour AI Strategy Session ($1,000, credited to the Sprint), then a two
        week Build-Ready Sprint that picks one workflow and specs the build, then a Pilot that puts a
        thin working system on your real work, then a monthly Run retainer if you want us to keep it
        running.
      </p>
    </div>
  </section>

  <section class="section paper-texture">
    <div class="container">
      <div class="rule-label reveal"><span>§ 01 · The Build-Ready Sprint</span></div>
      <div class="diag-card reveal">
        <div class="diag-main">
          <h3 class="diag-title">Build-Ready Sprint (two weeks, fixed fee)</h3>
          <p class="diag-desc">
            After a free Working Session, we pick one workflow together. Over two weeks we sit with the
            people who do the work, map where their time actually goes and where the exceptions live,
            and write the requirements for the first version of the system with you. At the end you get
            a fixed scope and plan for the Pilot, and if we do not find enough to justify one, we tell
            you that instead of selling you something.
          </p>
          <ul class="doc-list">
            <li>A plain map of where your team's time actually goes</li>
            <li>Written requirements for the thin first version of the system</li>
            <li>A fixed scope and plan for a $35,000 Pilot, with no hourly meter</li>
          </ul>
        </div>
        <div class="diag-price-col">
          <div class="label diag-price-label">Fixed fee</div>
          <div class="diag-price">$9,500</div>
          <div class="diag-credit">Fully credited to the $35,000 Pilot</div>
          <a href="/contact" class="btn">Scope a Bespoke Build</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section paper-texture">
    <div class="container">
      <div class="rule-label reveal"><span>§ 02 · The Bespoke Build</span></div>
      <div class="build-card reveal">
        <div class="build-main">
          <span class="pricing-num">PRIMARY OFFERING</span>
          <h3 class="build-title">The Bespoke Build</h3>
          <p class="diag-desc">
            This is the work we lead with, a system built around how your business really runs after we have sat with your team in the Sprint, and it is scoped and priced once the requirements are written rather than before, because the
            price of a bespoke system depends on what it has to do, what it has to connect to and how
            much of it you want in the first version. You can start with one workflow and see how we
            work before taking on more, or bring us the whole picture and we will scope it with you in
            steps, and in both cases each step is quoted and agreed before it starts.
          </p>
          <ul class="doc-list">
            <li>Requirements written with your team before anything is built</li>
            <li>A thin working system first, then scoped steps from there</li>
            <li>Agents built into the system wherever they are the right tool for the job</li>
            <li>You own the code, the harness that runs, tests and deploys it, and the data</li>
          </ul>
        </div>
        <div class="diag-price-col">
          <div class="label diag-price-label">Pricing</div>
          <div class="build-price">Pilot: $35,000</div>
          <div class="diag-credit">Sprint fee credited. Later steps are quoted in writing before work begins</div>
          <a href="/bespoke" class="btn btn-secondary">How a Bespoke Build Runs</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="rule-label reveal"><span>§ 03 · The Ladder</span></div>
      <p class="pricing-intro reveal">
        Five steps, each one agreed before it starts, so you can stop after any of them.
      </p>
      <div class="grid grid-4 pricing-grid">
        {packages.map((pkg) => (
          <div class="pricing-card reveal">
            <div class="pricing-card-header">
              <span class="pricing-num">STEP {pkg.num}</span>
              <h3 class="pricing-name">{pkg.name}</h3>
            </div>
            <p class="pricing-tagline">{pkg.tagline}</p>
            <hr class="rule" />
            <div class="pricing-price-group">
              <div class="pricing-price-label label">Price</div>
              <div class="pricing-price">{pkg.implementation}</div>
            </div>
            <div class="pricing-price-group">
              <div class="pricing-price-label label">Terms</div>
              <div class="pricing-price-sm">{pkg.managed}</div>
            </div>
            <hr class="rule" />
            <ul class="doc-list pricing-features">
              {pkg.features.map((f) => <li>{f}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <p class="pricing-note reveal">
        The Run retainer covers monitoring, maintenance and model costs, plus a working session every
        month with the people who built it. Whatever we build, the code, the harness and the data stay
        yours, and if you ever decide to run it yourself everything stays where it is.
      </p>
    </div>
  </section>

  <CTA
    headline="Not sure where to start?"
    subtext="Book a free Working Session and walk us through the work, and we will tell you honestly whether it calls for a bespoke build or not, and which workflow to start with."
    fileNo="SAVOI-006 / CTA"
  />
</Base>

<style>
  .page-subtitle { font-size: 1.125rem; line-height: 1.65; color: var(--ink-faint); max-width: 680px; margin-top: 1.5rem; }
  .pricing-intro { font-size: 1.0625rem; line-height: 1.7; color: var(--ink-faint); max-width: 70ch; margin-bottom: 2rem; }
  .build-card {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 2.5rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--classification);
    border-radius: var(--radius);
    padding: 2.25rem;
    align-items: start;
  }
  .build-title { font-size: 1.75rem; margin: 0.35rem 0 0.75rem; }
  .build-price { font-size: 1.375rem; font-weight: 700; line-height: 1.25; font-family: 'Spectral', serif; }
  @media (max-width: 800px) { .build-card { grid-template-columns: 1fr; } }

  .page-hero { padding: 5rem 0 4rem; }
  .page-meta { color: var(--file-tab); margin-bottom: 1rem; }
  .page-title { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 800; line-height: 1.1; }
  .page-title-accent { color: var(--classification-soft); font-style: italic; font-weight: 600; }

  .pricing-grid { margin-top: 1rem; align-items: start; }
  .grid-4 { display: grid; gap: 1rem; grid-template-columns: repeat(5, 1fr); }
  @media (max-width: 1100px) { .grid-4 { grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); } }
  .pricing-note {
    margin-top: 2.5rem;
    padding: 1.25rem 1.5rem;
    border-left: 2px solid var(--classification);
    background: var(--paper-2);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 760px;
  }
  /* cards sit on a dark section, which sets color:paper, so reassert ink inside them */
  .pricing-card, .pricing-card * { color: var(--ink); }
  .pricing-card .pricing-num { color: var(--ink-muted); }
  .pricing-card .pricing-price-label { color: var(--classification); }
  .pricing-card .pricing-tagline { color: var(--ink-soft); }
  .pricing-card .doc-list li::before { color: var(--classification); }
  .pricing-card .rule { border-top-color: var(--rule); }
  .pricing-card {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 2rem;
    position: relative;
    transition: border-color 200ms;
  }
  .pricing-card:hover { border-color: var(--rule-2); }
  .pricing-featured {
    border: 2px solid var(--file-tab);
    box-shadow: 0 4px 24px rgba(184,148,90,0.12);
  }
  .pricing-badge {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--file-tab);
    color: var(--ink);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 0.25rem 0.875rem;
    border-radius: var(--radius);
  }
  .pricing-card-header { margin-bottom: 0.625rem; }
  .pricing-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--file-tab);
  }
  .pricing-name { font-size: 1.75rem; font-weight: 700; margin: 0.25rem 0 0; }
  .pricing-tagline { font-size: 0.875rem; color: var(--ink-muted); margin: 0; line-height: 1.4; }
  .pricing-price-group { margin-bottom: 1rem; }
  .pricing-price-label { color: var(--ink-muted); margin-bottom: 0.25rem; }
  .pricing-price { font-size: 1.25rem; font-weight: 700; color: var(--ink); font-family: 'Spectral', serif; }
  .pricing-price-sm { font-size: 0.9375rem; color: var(--ink-soft); font-family: 'Spectral', serif; }
  .pricing-features { margin-top: 0.5rem; }
  .pricing-features li { font-size: 0.875rem; }

  .diag-card {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 2.5rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--classification);
    border-radius: var(--radius);
    padding: 2.25rem;
    align-items: start;
  }
  .diag-title { font-size: 1.375rem; margin-bottom: 0.75rem; }
  .diag-desc { font-size: 0.9688rem; line-height: 1.65; color: var(--ink-soft); margin-bottom: 1.25rem; }
  .diag-price-col { display: flex; flex-direction: column; gap: 0.6rem; align-items: flex-start; border-left: 1px solid var(--rule); padding-left: 2rem; }
  .diag-price-label { color: var(--classification); }
  .diag-price { font-size: 2.25rem; font-weight: 800; letter-spacing: -0.02em; }
  .diag-credit { font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; line-height: 1.5; color: var(--ink-muted); letter-spacing: 0.02em; max-width: 220px; margin-bottom: 0.75rem; }
  @media (max-width: 800px) {
    .diag-card { grid-template-columns: 1fr; }
    .diag-price-col { border-left: none; padding-left: 0; border-top: 1px solid var(--rule); padding-top: 1.5rem; }
  }

  @media (max-width: 900px) {
    .pricing-grid { grid-template-columns: 1fr; max-width: 480px; margin: 1rem auto 0; }
  }
</style>
