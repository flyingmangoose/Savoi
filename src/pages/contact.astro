---
import Base from '../layouts/Base.astro';

const title = 'Book a Workflow Call | Savoi.ai';
---

<Base title={title} fileNo="SAVOI-009" classification="INTAKE FORM">
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-meta label">FILE 09 — GET STARTED</div>
      <h1 class="page-title reveal">Book a 30-Minute<br /><span class="page-title-accent">Call With Us</span></h1>
      <p class="page-subtitle reveal">
        We'll find 1–2 things eating your time and show you exactly what an
        AI employee would handle.<br />
        No sales pitch. No pressure. Just a clear picture of what it costs
        and what you'd get.
      </p>
    </div>
  </section>

  <section class="section paper-texture">
    <div class="container contact-grid">
      <div class="contact-form-wrap">
        <form class="contact-form" id="savoi-contact-form" novalidate>
          <div class="form-group">
            <label class="form-label" for="name">Name</label>
            <input class="form-input" type="text" id="name" name="name" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="company">Company</label>
            <input class="form-input" type="text" id="company" name="company" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="email">Email</label>
            <input class="form-input" type="email" id="email" name="email" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="role">Role</label>
            <input class="form-input" type="text" id="role" name="role" />
          </div>
          <div class="form-group">
            <label class="form-label" for="process">
              What's eating the most time in your business right now?
              <span class="form-optional">optional</span>
            </label>
            <textarea class="form-textarea" id="process" name="process" rows="4" placeholder="Tell us about the repetitive stuff that's slowing you down..."></textarea>
          </div>
          <button type="submit" class="btn contact-submit" id="savoi-submit">Book My Call</button>
          <p class="form-status" id="savoi-form-status" role="status" aria-live="polite"></p>
        </form>
      </div>

      <aside class="contact-aside">
        <div class="contact-aside-block">
          <div class="label contact-aside-label">ALTERNATIVE</div>
          <p class="contact-aside-text">Prefer email?</p>
          <a href="mailto:commercial@savoi.ai" class="contact-email">commercial@savoi.ai</a>
        </div>
        <div class="contact-aside-block">
          <div class="label contact-aside-label">WHAT TO EXPECT</div>
          <ul class="doc-list contact-expect">
            <li>30 minutes, no commitment</li>
            <li>We find 1–2 things eating your time</li>
            <li>You see exactly what your AI employee would do</li>
            <li>Clear pricing, no surprises</li>
          </ul>
        </div>
        <div class="contact-aside-block">
          <div class="label contact-aside-label">RESPONSE TIME</div>
          <p class="contact-aside-text">We respond within one business day.</p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .page-hero { padding: 5rem 0 4rem; }
  .page-meta { color: var(--file-tab); margin-bottom: 1rem; }
  .page-title { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 800; line-height: 1.1; }
  .page-title-accent { color: var(--classification-soft); font-style: italic; font-weight: 600; }
  .page-subtitle { font-size: 1.125rem; color: var(--ink-faint); max-width: 620px; line-height: 1.65; }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  .contact-form { max-width: 540px; }
  .contact-submit { margin-top: 0.5rem; }
  .form-status { font-family: 'JetBrains Mono', monospace; font-size: 0.8125rem; margin-top: 1rem; min-height: 1.25rem; }
  .form-status.ok { color: var(--stamp-green); }
  .form-status.err { color: var(--classification); }

  .contact-aside { display: flex; flex-direction: column; gap: 2rem; padding-left: 2rem; border-left: 1px solid var(--rule); }
  .contact-aside-label { color: var(--classification); margin-bottom: 0.75rem; }
  .contact-aside-text { font-size: 0.9375rem; color: var(--ink-soft); margin: 0 0 0.5rem; }
  .contact-email {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    color: var(--classification);
    text-decoration: none;
  }
  .contact-email:hover { color: var(--ink); }
  .contact-expect li { font-size: 0.875rem; }

  @media (max-width: 800px) {
    .contact-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .contact-aside { padding-left: 0; border-left: none; border-top: 1px solid var(--rule); padding-top: 2rem; }
  }
</style>

<script>
  const PORTAL_ID = '24211389';
  const FORM_GUID = 'dff85219-f923-4afe-ab33-f913c885c00e';

  const form = document.getElementById('savoi-contact-form');
  const status = document.getElementById('savoi-form-status');
  const submitBtn = document.getElementById('savoi-submit');

  function getCookie(name) {
    const m = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
    return m ? m[2] : undefined;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;

    const name = (document.getElementById('name')).value.trim();
    const spaceAt = name.indexOf(' ');
    const firstname = spaceAt === -1 ? name : name.slice(0, spaceAt);
    const lastname = spaceAt === -1 ? '' : name.slice(spaceAt + 1);

    const fields = [
      { objectTypeId: '0-1', name: 'email', value: (document.getElementById('email')).value.trim() },
      { objectTypeId: '0-1', name: 'firstname', value: firstname },
      { objectTypeId: '0-1', name: 'company', value: (document.getElementById('company')).value.trim() },
    ];
    if (lastname) fields.push({ objectTypeId: '0-1', name: 'lastname', value: lastname });
    const role = (document.getElementById('role')).value.trim();
    if (role) fields.push({ objectTypeId: '0-1', name: 'jobtitle', value: role });
    const process = (document.getElementById('process')).value.trim();
    if (process) fields.push({ objectTypeId: '0-1', name: 'message', value: process });

    const payload = {
      fields,
      context: {
        pageUri: window.location.href,
        pageName: document.title,
      },
    };
    const hutk = getCookie('hubspotutk');
    if (hutk) payload.context.hutk = hutk;

    submitBtn.disabled = true;
    status.textContent = 'FILING...';
    status.className = 'form-status';

    try {
      const res = await fetch(`https://api.hsforms.com/submissions/v3/integration/submit/${PORTAL_ID}/${FORM_GUID}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        status.textContent = 'RECEIVED. WE RESPOND WITHIN ONE BUSINESS DAY.';
        status.className = 'form-status ok';
        form.reset();
      } else {
        throw new Error('submit failed');
      }
    } catch {
      status.textContent = 'SOMETHING BROKE. EMAIL US INSTEAD: COMMERCIAL@SAVOI.AI';
      status.className = 'form-status err';
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
