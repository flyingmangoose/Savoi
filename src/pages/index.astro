---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import AgentPanel from '../components/AgentPanel.astro';
import SystemDiagram from '../components/SystemDiagram.astro';

const title = 'Savoi.ai — Managed Agents. AI Employees That Actually Do the Work';
---

<Base title={title} fileNo="SAVOI-001" classification="FOR PUBLIC RELEASE">
  <!-- ════════ HERO ════════ -->
  <section class="hero">
    <div class="hero-grid"></div>
    <div class="container hero-inner">
      <div class="hero-content">
        <div class="hero-meta">
          <span class="label hero-meta-item">MANAGED AGENTS // BUILT · INSTALLED · RUN</span>
          <span class="stamp stamp-animate">Proven in Production</span>
        </div>
        <h1 class="hero-headline reveal">
          AI Employees<br />
          <span class="hero-headline-accent">That Actually Do</span><br />
          The Work
        </h1>
        <p class="hero-subhead reveal">
          We build AI that knows your products, answers your customers' questions,
          drafts your quotes, and follows up on your deals — all inside the tools
          you already use. You approve anything that costs money. It handles the rest.
        </p>
        <p class="hero-category reveal">
          These are managed agents. We build them, install them in your tools,
          and run them for you. When something breaks, our phone rings, not yours.
        </p>
        <div class="hero-actions reveal">
          <a href="/contact" class="btn">Book a Workflow Call</a>
          <a href="/what-we-install" class="btn btn-secondary">See How It Works</a>
        </div>
      </div>
    </div>
    <div class="hero-bottom-bar">
      <div class="container hero-logos">
        <span class="hero-logos-k label">WORKS INSIDE THE SYSTEMS YOU ALREADY RUN</span>
        <div class="hero-logos-marks">
          <img src="/logos/salesforce.svg" alt="Salesforce" width="24" height="24" />
          <img src="/logos/oracle.svg" alt="Oracle" width="24" height="24" />
          <img src="/logos/sap.svg" alt="SAP" width="24" height="24" />
          <img src="/logos/workday.svg" alt="Workday" width="24" height="24" />
          <img src="/logos/dynamics-365.svg" alt="Microsoft Dynamics 365" width="24" height="24" />
          <img src="/logos/netsuite.svg" alt="NetSuite" width="24" height="24" />
          <img src="/logos/hubspot.svg" alt="HubSpot" width="24" height="24" />
          <img src="/logos/quickbooks.svg" alt="QuickBooks" width="24" height="24" />
          <img src="/logos/slack.svg" alt="Slack" width="24" height="24" />
          <img src="/logos/microsoft-teams.svg" alt="Microsoft Teams" width="24" height="24" />
        </div>
        <a href="#integrations" class="hero-logos-link">and the ones nobody else supports →</a>
      </div>
    </div>
  </section>

  <!-- ════════ INTEGRATIONS ════════ -->
  <section class="section paper-texture" id="integrations">
    <div class="container">
      <div class="rule-label reveal"><span>§ 01 — What It Plugs Into</span></div>
      <h2 class="int-headline reveal">It doesn't just read your systems.<br /><span class="int-accent">It works in them.</span></h2>
      <p class="int-lede reveal">
        Your ERP and CRM already hold the answers. What they have never had is somebody
        who acts on them. A managed agent creates the record, drafts the quote, updates
        the deal, files the bill, and builds the report, then brings you the handful of
        decisions that actually need a person.
      </p>
      <p class="int-lede int-lede-2 reveal">
        Think of it as a team that has worked in your business, and your industry, for
        decades. It knows your products, your customers, your pricing discipline, and
        your process, and it does the work inside the tools your team already opens.
        Nothing new to learn. No portal to log into.
      </p>

      <div class="int-band">
        <div class="int-row int-row-hero reveal">
          <span class="int-row-k label">WORKS INSIDE</span>
          <div class="int-marks int-marks-lg">
            <span class="int-mark"><img src="/logos/salesforce.svg" alt="" width="34" height="34" /><span>Salesforce</span></span>
            <span class="int-mark"><img src="/logos/oracle.svg" alt="" width="34" height="34" /><span>Oracle</span></span>
            <span class="int-mark"><img src="/logos/sap.svg" alt="" width="34" height="34" /><span>SAP</span></span>
            <span class="int-mark"><img src="/logos/workday.svg" alt="" width="34" height="34" /><span>Workday</span></span>
            <span class="int-mark"><img src="/logos/dynamics-365.svg" alt="" width="34" height="34" /><span>Dynamics 365</span></span>
            <span class="int-mark"><img src="/logos/netsuite.svg" alt="" width="34" height="34" /><span>NetSuite</span></span>
            <span class="int-mark"><img src="/logos/hubspot.svg" alt="" width="34" height="34" /><span>HubSpot</span></span>
            <span class="int-mark"><img src="/logos/sage.svg" alt="" width="34" height="34" /><span>Sage</span></span>
            <span class="int-mark"><img src="/logos/quickbooks.svg" alt="" width="34" height="34" /><span>QuickBooks</span></span>
          </div>
        </div>
        <div class="int-row reveal">
          <span class="int-row-k label">AND ACROSS</span>
          <div class="int-marks">
            <span class="int-mark"><img src="/logos/microsoft-365.svg" alt="" width="26" height="26" /><span>Microsoft 365</span></span>
            <span class="int-mark"><img src="/logos/google-workspace.svg" alt="" width="26" height="26" /><span>Google Workspace</span></span>
          </div>
        </div>
        <div class="int-row reveal">
          <span class="int-row-k label">REPORTS BACK IN</span>
          <div class="int-marks">
            <span class="int-mark"><img src="/logos/slack.svg" alt="" width="26" height="26" /><span>Slack</span></span>
            <span class="int-mark"><img src="/logos/microsoft-teams.svg" alt="" width="26" height="26" /><span>Teams</span></span>
            <span class="int-mark"><img src="/logos/imessage.svg" alt="" width="26" height="26" /><span>iMessage</span></span>
            <span class="int-mark"><img src="/logos/telegram.svg" alt="" width="26" height="26" /><span>Telegram</span></span>
            <span class="int-mark"><img src="/logos/whatsapp.svg" alt="" width="26" height="26" /><span>WhatsApp</span></span>
          </div>
        </div>
      </div>

      <div class="int-custom reveal">
        <div class="int-custom-k label">AND THE ONES NOBODY ELSE SUPPORTS</div>
        <p class="int-custom-text">
          The industry system with an API and no integrations. The internal database. The
          spreadsheets on the shared drive, the document library, the twenty-year-old
          system everybody complains about. Off-the-shelf AI connects to whatever its
          vendor decided to support, and then hands the actual work back to you. We build
          the connection your business runs on, and the agent does the work on the other
          side of it.
        </p>
      </div>

      <p class="int-note reveal">
        Every connection uses your own credentials, and you decide what it is allowed to
        change. Anything that costs money or leaves the building waits for a human yes.
        Product names and logos belong to their owners and are shown to indicate
        compatibility, not partnership.
      </p>
    </div>
  </section>

  <!-- ════════ EXHIBIT A: TRANSCRIPT ════════ -->
  <section class="section section-dark">
    <div class="container">
      <div class="rule-label reveal"><span>§ 02 — Exhibit A: Two Minutes of Real Work</span></div>
      <div class="tx-layout">
        <div class="tx-panel reveal">
          <div class="tx-head label">#finance-ops</div>
          <div class="tx-msg">
            <div class="tx-meta"><span class="tx-who">Finance Lead</span><span class="tx-time">9:41 AM</span></div>
            <p class="tx-text">@Irma new bill. $3,200 from Zoom, due March 15, Operations.</p>
          </div>
          <div class="tx-msg">
            <div class="tx-meta"><span class="tx-who tx-agent">Irma</span><span class="tx-badge">AGENT</span><span class="tx-time">9:41 AM</span></div>
            <p class="tx-text">Created in the ERP as unpaid. Vendor and category match last month, no duplicate found. Approve for the March 14 payment run?</p>
          </div>
          <div class="tx-msg">
            <div class="tx-meta"><span class="tx-who">Finance Lead</span><span class="tx-time">9:43 AM</span></div>
            <p class="tx-text">Approved.</p>
          </div>
          <div class="tx-msg">
            <div class="tx-meta"><span class="tx-who tx-agent">Irma</span><span class="tx-badge">AGENT</span><span class="tx-time">9:43 AM</span></div>
            <p class="tx-text">Queued for payment and logged. It will show in Friday's summary with the other four bills this week.</p>
          </div>
        </div>
        <div class="tx-side reveal">
          <h2 class="tx-headline">This is the whole pitch.</h2>
          <p class="tx-body">
            A bill arrived, got filed correctly, waited for a human yes, and got paid.
            No one opened a portal. No one uploaded a PDF. No one remembered to
            reconcile it later.
          </p>
          <p class="tx-body">
            That exchange is from our own firm, where Irma has run operations since
            2025. Every agent we install works the same way: real system access,
            real approval gates, and a person in the loop wherever money moves.
          </p>
          <a href="/irma" class="btn btn-secondary">Read Irma's File</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════ WHAT YOU GET ════════ -->
  <section class="section paper-texture">
    <div class="container">
      <div class="rule-label reveal">
        <span>§ 03 — What You Actually Get</span>
      </div>
      <div class="get-grid">
        <div class="get-main reveal">
          <h2 class="get-headline">An AI employee<br />that knows your business<br />inside and out.</h2>
          <p class="get-text">
            We study your products, your catalog, your pricing, and the way you talk
            to customers. Then we build AI that can do the work your best people do —
            answering product questions, matching specs to customer needs, drafting quotes,
            following up on deals, and running the repetitive tasks that eat your team's day.
          </p>
          <p class="get-text">
            It lives in your CRM, your email, your Slack or Teams. It works the same
            hours your customers do — all of them. And anything involving money or
            commitments comes to you for a yes or no first.
          </p>
        </div>
        <div class="get-side reveal">
          <div class="get-card">
            <div class="get-card-label label">WHAT IT HANDLES</div>
            <ul class="get-card-list">
              <li>Customer product questions — answered instantly, 24/7</li>
              <li>Spec matching — "will this work for my project?"</li>
              <li>Quote drafts — ready for you to approve and send</li>
              <li>Follow-ups — no deal goes quiet</li>
              <li>Pipeline reports — compiled and sent on schedule</li>
              <li>Overdue invoice reminders — sent automatically</li>
            </ul>
          </div>
          <div class="get-card get-card-dark">
            <div class="get-card-label label">WHAT YOU STILL DO</div>
            <ul class="get-card-list">
              <li>Approve quotes and pricing</li>
              <li>Handle the complex, high-value conversations</li>
              <li>Make the final call on commitments</li>
              <li>Set the rules — what the AI can and can't do</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════ WHAT AN AGENT OWNS ════════ -->
  <section class="section section-dark">
    <div class="container">
      <div class="rule-label reveal">
        <span>§ 04 — What a Managed Agent Actually Does</span>
      </div>
      <div class="owns-grid">
        <div class="owns-left">
          <h2 class="owns-headline reveal">
            This is not a chatbot.<br />
            <span class="owns-headline-accent">This is a managed agent<br />that owns real work.</span>
          </h2>
          <ul class="owns-list">
            <li class="owns-item reveal">
              <span class="owns-num">01</span>
              <div>
                <h4>It remembers your business</h4>
                <p>Knows your products, your customers, and your way of doing things. It doesn't start from scratch every time.</p>
              </div>
            </li>
            <li class="owns-item reveal">
              <span class="owns-num">02</span>
              <div>
                <h4>It uses your tools</h4>
                <p>Slack, Teams, your CRM, email, your internal systems. It works where you already work.</p>
              </div>
            </li>
            <li class="owns-item reveal">
              <span class="owns-num">03</span>
              <div>
                <h4>It's a team, not just one thing</h4>
                <p>Different AI specialists for sales, support, operations. They hand off to each other so nothing falls through the cracks.</p>
              </div>
            </li>
            <li class="owns-item reveal">
              <span class="owns-num">04</span>
              <div>
                <h4>You approve anything important</h4>
                <p>Pricing, commitments, big decisions. Anything that matters goes through you first. You set the rules.</p>
              </div>
            </li>
            <li class="owns-item reveal">
              <span class="owns-num">05</span>
              <div>
                <h4>Smart about cost</h4>
                <p>Uses the right AI for the right job. Heavy thinking gets the good stuff. Simple tasks get the fast, affordable stuff. You don't overpay.</p>
              </div>
            </li>
            <li class="owns-item reveal">
              <span class="owns-num">06</span>
              <div>
                <h4>It comes with the operator</h4>
                <p>Managed means managed. We monitor it, maintain it, and improve it under retainer, the way your MSP runs your network. You get an employee, not a project.</p>
              </div>
            </li>
          </ul>
        </div>
        <div class="owns-panel reveal">
          <AgentPanel />
        </div>
      </div>
    </div>
  </section>

  <!-- ════════ WHAT CHANGES ════════ -->
  <section class="section paper-texture">
    <div class="container">
      <div class="rule-label reveal">
        <span>§ 05 — What Changes</span>
      </div>
      <div class="changes-grid">
        <div class="changes-col changes-before reveal">
          <div class="changes-header">
            <span class="changes-label label">WITHOUT</span>
            <span class="changes-tag changes-tag-before">BEFORE</span>
          </div>
          <ul class="changes-list">
            <li>A distributor calls about load ratings — your best guy is in a meeting</li>
            <li>Same product spec questions, asked 40 times a week</li>
            <li>Quotes sit in someone's inbox for two days</li>
            <li>Hot leads go cold because nobody followed up</li>
            <li>Your sales team is answering basic questions instead of closing deals</li>
          </ul>
        </div>
        <div class="changes-col changes-after reveal">
          <div class="changes-header">
            <span class="changes-label label">WITH SAVOI</span>
            <span class="changes-tag changes-tag-after">AFTER</span>
          </div>
          <ul class="changes-list">
            <li>The AI answers load-rating questions instantly — correctly, every time</li>
            <li>Your experts only get the questions that actually need them</li>
            <li>Quotes are drafted in minutes, waiting for your approval</li>
            <li>Every lead gets a follow-up — automatically, on time</li>
            <li>Your sales team closes deals while the AI handles the rest</li>
          </ul>
        </div>
      </div>
      <div class="changes-proof reveal">
        <span class="stamp stamp-green stamp-animate">Case Verified</span>
        <p class="changes-proof-text">
          Already proven inside our own firm, and with a global plywood manufacturer
          whose senior team got their time back.
          <a href="/case-studies" class="changes-proof-link">Read the case study →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ════════ SOVEREIGNTY ════════ -->
  <section class="section section-dark" id="sovereignty-note">
    <div class="container">
      <div class="rule-label reveal"><span>§ 06 — Where It Lives</span></div>
      <div class="sov-grid">
        <div class="sov-lead reveal">
          <h2 class="sov-headline">Your secret sauce stays<br /><span class="sov-accent">in the building.</span></h2>
          <p class="sov-text">
            The whole point of a managed agent is that it holds what your company actually
            knows. Which supplier delivers on the promise and which one does not. What a
            particular customer will accept. What margin to hold and when to walk away.
            That is not public information. It is the reason you win business your
            competitors do not.
          </p>
          <p class="sov-text">
            Which makes the next question the important one. Once that knowledge is
            written down, where does it live? Put it in a hosted AI platform and the most
            valuable thing you own becomes a configuration in a vendor's account, on
            infrastructure you do not control, governed by terms you did not write and
            cannot see change.
          </p>
          <p class="sov-text">
            So we do not do that. Your agent runs on a machine in your building. The
            knowledge base sits on your disk, in files you can open. Every system it
            touches is connected with your own credentials, read-only by default. Nothing
            about how your company operates ends up as leverage in somebody's renewal
            conversation.
          </p>
        </div>
        <div class="sov-panel reveal">
          <div class="sov-panel-head label">CUSTODY</div>
          <div class="sov-row"><span class="sov-k">Hardware</span><span class="sov-v">Yours. On your premises.</span></div>
          <div class="sov-row"><span class="sov-k">Knowledge base</span><span class="sov-v">Your disk. Readable files.</span></div>
          <div class="sov-row"><span class="sov-k">Credentials</span><span class="sov-v">Yours. Read-only by default.</span></div>
          <div class="sov-row"><span class="sov-k">Data in transit</span><span class="sov-v">Stays inside your network.</span></div>
          <div class="sov-row"><span class="sov-k">If you fire us</span><span class="sov-v">Everything stays where it is.</span></div>
          <p class="sov-note">
            A company's operating knowledge is an asset. Assets belong on your balance
            sheet, not in someone else's account.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════ FINAL CTA ════════ -->
  <CTA
    headline="Ready for an employee that never sleeps?"
    subtext="Book a 30-minute call. We'll find 1–2 things eating your time and show you exactly what your AI employee would handle."
    buttonLabel="Book a Workflow Call"
    fileNo="SAVOI-001 / CTA"
  />
</Base>

<style>
  /* HERO */
  .hero {
    background: var(--ink);
    color: var(--paper);
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem 0 0;
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(0deg, transparent, transparent 59px, rgba(244,239,230,0.03) 59px, rgba(244,239,230,0.03) 60px),
      repeating-linear-gradient(90deg, transparent, transparent 59px, rgba(244,239,230,0.03) 59px, rgba(244,239,230,0.03) 60px);
    pointer-events: none;
  }
  .hero-inner { position: relative; z-index: 1; flex: 1; display: flex; align-items: center; }
  .hero-content { max-width: 760px; padding: 2rem 0; }
  .hero-meta { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; }
  .hero-meta-item { color: var(--file-tab); }
  .hero-headline {
    font-size: clamp(2.75rem, 7vw, 5rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin-bottom: 1.75rem;
  }
  .hero-headline-accent { color: var(--classification-soft); font-style: italic; font-weight: 600; }
  .hero-subhead {
    font-size: 1.1875rem;
    line-height: 1.65;
    color: var(--ink-faint);
    max-width: 620px;
    margin-bottom: 1.5rem;
  }
  .hero-category {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--file-tab);
    max-width: 620px;
    margin-bottom: 2.5rem;
    padding-left: 1rem;
    border-left: 2px solid var(--classification);
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

  .hero-bottom-bar {
    position: relative;
    z-index: 1;
    background: var(--ink-2);
    border-top: 1px solid var(--ink-soft);
    padding: 1.5rem 0;
  }

  /* WHAT YOU GET */
  .get-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 3rem; align-items: start; }
  .get-headline { font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 700; line-height: 1.15; margin-bottom: 1.5rem; }
  .get-text { font-size: 1rem; line-height: 1.65; color: var(--ink-soft); margin-bottom: 1rem; }
  .get-side { display: flex; flex-direction: column; gap: 1.25rem; }
  .get-card {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 1.75rem;
  }
  .get-card-dark { background: var(--ink); color: var(--paper); }
  .get-card-label { color: var(--classification); margin-bottom: 1rem; }
  .get-card-dark .get-card-label { color: var(--file-tab); }
  .get-card-list { list-style: none; }
  .get-card-list li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .get-card-list li::before {
    content: '▸';
    position: absolute;
    left: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--classification);
  }
  .get-card-dark .get-card-list li::before { color: var(--classification-soft); }
  .get-card-dark .get-card-list li { color: var(--paper); }

  /* OWNS */
  .owns-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
  /* EXHIBIT A — TRANSCRIPT */
  .tx-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; margin-top: 1rem; }
  .tx-panel { background: var(--ink-2); border: 1px solid var(--ink-soft); border-radius: var(--radius); padding: 1.75rem; }
  .tx-head { color: var(--file-tab); padding-bottom: 1.125rem; margin-bottom: 1.125rem; border-bottom: 1px solid var(--ink-soft); }
  .tx-msg { margin-bottom: 1.125rem; }
  .tx-msg:last-child { margin-bottom: 0; }
  .tx-meta { display: flex; align-items: baseline; gap: 0.6rem; margin-bottom: 0.25rem; }
  .tx-who { font-weight: 700; font-size: 0.9375rem; color: var(--paper); }
  .tx-agent { color: var(--classification-soft); }
  .tx-badge { font-family: 'JetBrains Mono', monospace; font-size: 0.5625rem; font-weight: 700; letter-spacing: 0.12em; padding: 0.1rem 0.45rem; border: 1px solid var(--classification-soft); border-radius: var(--radius); color: var(--classification-soft); }
  .tx-time { font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; color: var(--ink-faint); }
  .tx-text { font-size: 0.9375rem; line-height: 1.55; color: var(--paper); margin: 0; }
  .tx-headline { font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 700; line-height: 1.15; margin-bottom: 1.25rem; }
  .tx-body { font-size: 1rem; line-height: 1.65; color: var(--ink-faint); margin-bottom: 1.25rem; }
  @media (max-width: 900px) { .tx-layout { grid-template-columns: 1fr; gap: 2rem; } }

  .owns-headline { font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.15; font-weight: 700; margin-bottom: 2rem; }
  .owns-headline-accent { color: var(--classification-soft); font-style: italic; }
  .owns-list { list-style: none; }
  .owns-item { display: flex; gap: 1.25rem; padding-bottom: 1.75rem; margin-bottom: 1.75rem; border-bottom: 1px solid var(--ink-soft); }
  .owns-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
  .owns-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--file-tab);
    letter-spacing: 0.06em;
    flex-shrink: 0;
    padding-top: 0.15rem;
  }
