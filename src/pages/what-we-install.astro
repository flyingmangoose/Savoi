---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import SystemDiagram from '../components/SystemDiagram.astro';

const title = 'What We Build · Bespoke Systems, With Agents Where They Fit | Savoi.ai';
const capabilities = [
  { num: '01', title: 'Built From Your Requirements', desc: 'Every system starts with requirements written alongside the people who do the work, so what gets built reflects how your business really runs, exceptions included, rather than how a product thinks a business like yours ought to run.' },
  { num: '02', title: 'It Knows Your Business', desc: 'Your products, your customers, your pricing rules and the judgment calls your senior people make every day end up written into the system, which means it does not start from zero every time someone asks it something.' },
  { num: '03', title: 'It Works in Your Tools', desc: 'Your CRM, ERP, email, Slack or Teams, calendar and inventory system are where the work already happens, so that is where the system does its work and reports back, with nothing new for your team to log into.' },
  { num: '04', title: 'Agents Where They Fit', desc: 'When part of the job needs judgment over messy inputs, like reading a bill or drafting a reply, we build an AI agent into the system for that piece, and when a plain rule or a scheduled report does it better, that is what we build instead.' },
  { num: '05', title: 'It Runs on Its Own', desc: 'Scheduled work, monitoring, follow-ups and alerts that need to happen every day or every week just happen, so nobody on your team has to remember to kick them off.' },
  { num: '06', title: 'You Stay in Control', desc: 'Anything involving pricing, commitments or big decisions can require a person to approve it first, and you decide where that line sits and what the system is allowed to do on its own.' },
];

const phases = [
  { num: '01', title: 'We Learn the Business', duration: 'Diagnostic', desc: 'We sit with your team, find the work eating the most time and money, and write the requirements for the first version of the system together with you.' },
  { num: '02', title: 'We Ship a Thin System', duration: 'First build', desc: 'We build a small version that runs end to end on your real work, connected to your tools with the right guardrails in place, so your team can use it and react to it early.' },
  { num: '03', title: 'We Grow It in Steps', duration: 'Scoped steps', desc: 'Each extension is scoped and agreed before it starts, and we document everything as we go so your people know exactly how the system works.' },
  { num: '04', title: 'You Own It', duration: 'Handover', desc: 'You keep the code, the harness that runs, tests and deploys it, and the data, and you can run it yourself or have us keep running it under a managed retainer.' },
];
---

<Base title={title} fileNo="SAVOI-A01" classification="FOR PUBLIC RELEASE">
  <!-- HERO -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-meta label">FILE A01 · WHAT WE BUILD</div>
      <h1 class="page-title reveal">Bespoke Systems, With Agents Where They Fit</h1>
      <p class="page-subtitle reveal">
        We do not install a product and walk away. We build a system around how your business really
        runs, put AI agents inside it wherever they are the right tool for a piece of the work, and
        hand you the whole thing to own, including the code, the harness that runs it and the data.
      </p>
    </div>
  </section>

  <!-- CORE CAPABILITIES -->
  <section class="section paper-texture">
    <div class="container">
      <div class="rule-label reveal"><span>§ 01 · What a Bespoke System Can Do</span></div>
      <div class="grid grid-2">
        {capabilities.map((cap) => (
          <div class="doc-card cap-card reveal">
            <div class="doc-card-header">
              <span class="doc-card-number">SPEC {cap.num}</span>
            </div>
            <h3 class="cap-title">{cap.title}</h3>
            <p class="cap-desc">{cap.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SYSTEM DIAGRAM -->
  <section class="section section-dark">
    <div class="container">
      <div class="rule-label reveal"><span>§ 02 · How the Agents Inside a Build Are Structured</span></div>
      <div class="diagram-wrap reveal">
        <SystemDiagram />
      </div>
    </div>
  </section>

  <!-- HOW ENGAGEMENTS WORK -->
  <section class="section section-dark">
    <div class="container">
      <div class="rule-label reveal"><span>§ 03 · How We Work With You</span></div>
      <div class="phases">
        {phases.map((phase) => (
          <div class="phase reveal">
            <div class="phase-header">
              <span class="phase-num">{phase.num}</span>
              <span class="phase-duration">{phase.duration}</span>
            </div>
            <h3 class="phase-title">{phase.title}</h3>
            <p class="phase-desc">{phase.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA
    headline="Want to see what we would build for your business?"
    subtext="Book a 30-minute call and walk us through the work that is eating your team's time, and we will tell you plainly what a bespoke build would look like and where agents would fit inside it."
    buttonLabel="Scope a Bespoke Build"
    fileNo="SAVOI-002 / CTA"
  />
</Base>

<style>
  .page-hero { padding: 5rem 0 4rem; }
  .page-meta { color: var(--file-tab); margin-bottom: 1rem; }
  .page-title { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 800; margin-bottom: 1.25rem; }
  .page-subtitle { font-size: 1.1875rem; color: var(--ink-faint); max-width: 620px; line-height: 1.65; }

  .diagram-wrap { max-width: 680px; margin: 0 auto; }
  .diagram-wrap :global(.system-diagram) { background: var(--ink-2); border-color: var(--ink-soft); }

  .cap-card { display: flex; flex-direction: column; }
  .cap-title { font-size: 1.1875rem; margin-bottom: 0.75rem; }
  .cap-desc { font-size: 0.9375rem; line-height: 1.6; color: var(--ink-soft); margin: 0; }

  .phases { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; }
  .phase {
    padding: 2rem;
    border-left: 1px solid var(--ink-soft);
    position: relative;
  }
  .phase:first-child { border-left: none; padding-left: 0; }
  .phase-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 1rem; }
  .phase-num { font-family: 'JetBrains Mono', monospace; font-size: 1.5rem; font-weight: 700; color: var(--file-tab); }
  .phase-duration { font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--classification-soft); }
  .phase-title { font-size: 1.125rem; margin-bottom: 0.625rem; color: var(--paper); }
  .phase-desc { font-size: 0.9375rem; line-height: 1.55; color: var(--ink-faint); margin: 0; }

  @media (max-width: 900px) {
    .phases { grid-template-columns: 1fr 1fr; }
    .phase { border-left: 1px solid var(--ink-soft); padding: 1.5rem; }
    .phase:nth-child(odd) { border-left: none; padding-left: 0; }
  }
  @media (max-width: 600px) {
    .phases { grid-template-columns: 1fr; }
    .phase { border-left: none; padding: 1.5rem 0; border-top: 1px solid var(--ink-soft); }
    .phase:first-child { border-top: none; }
  }
</style>
