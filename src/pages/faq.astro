---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';

const title = 'Common Questions | Savoi.ai';

const faqs = [
  {
    q: 'What is a managed agent?',
    a: "An AI employee we build for one job in your company and then run for you under a monthly retainer. Your business already works this way: an MSP is accountable for your network, a payroll company is accountable for payroll. Savoi is accountable for your AI employees. We build them, install them in your tools, monitor them, and improve them. You get the work, not another system to babysit.",
  },
  {
    q: 'We know our products better than anyone. Why do we need this?',
    a: "Exactly. The problem isn't that you don't know your products — it's that your best people spend all day answering the same questions instead of doing their real jobs. The AI becomes the always-on version of your best expert, so your people only deal with the conversations that actually need them.",
  },
  {
    q: 'Why not just use ChatGPT?',
    a: "ChatGPT is a brilliant intern with amnesia. It doesn't remember your products, can't access your systems, can't take any action, and doesn't sound like your brand. Every conversation starts from zero. What we build is a specialist employee that already knows your catalog, talks like you, and can actually do things — not just talk about them.",
  },
  {
    q: 'What AI technology do you use?',
    a: "We use different AI for different jobs. The hard, important work gets the best AI available. The simple, repetitive stuff gets faster, cheaper AI. This keeps quality high where it matters and costs down everywhere else. You're never locked into one provider.",
  },
  {
    q: "Doesn't Salesforce or Microsoft Copilot already do this?",
    a: "Those tools are great — inside their own world. But most real businesses use a mix of Slack, email, a CRM, an inventory system, and a lot of knowledge that lives in people's heads. Platform tools can't cross those boundaries. We build AI that works across all your tools and handles the whole job. Many of our clients already use Copilot or Salesforce and still need this.",
  },
  {
    q: 'How do you stop the AI from giving wrong answers?',
    a: "Two safeguards. First, the AI only answers based on the knowledge and tools we give it — your approved materials, not the open internet. Second, anything important (pricing, commitments, technical claims) can go through you for approval first. Simple questions run on their own. You decide where the line is.",
  },
  {
    q: 'This seems expensive. Can\u2019t we just build it ourselves?',
    a: "You can try. Most companies that do end up with something that works in a demo but falls apart when things change — a new product, a new team member, a new tool. What you're paying for is a system that actually works in production, with monitoring, cost controls, and an architecture that doesn't break when your business grows. The real cost of doing it yourself is usually higher once you count the time lost.",
  },
];
---

<Base title={title} fileNo="SAVOI-008" classification="FOR PUBLIC RELEASE">
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-meta label">FILE 08 — Q&A</div>
      <h1 class="page-title reveal">Questions You Probably Have</h1>
    </div>
  </section>

  <section class="section paper-texture">
    <div class="container faq-container">
      {faqs.map((faq, i) => (
        <div class="faq-item reveal">
          <div class="faq-num">Q.{String(i + 1).padStart(2, '0')}</div>
          <div class="faq-body">
            <h3 class="faq-question">{faq.q}</h3>
            <p class="faq-answer">{faq.a}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <CTA
    headline="Still have questions?"
    subtext="Book a call. We'll answer everything honestly — no sales pitch, no pressure."
    fileNo="SAVOI-008 / CTA"
  />
</Base>

<style>
  .page-hero { padding: 5rem 0 4rem; }
  .page-meta { color: var(--file-tab); margin-bottom: 1rem; }
  .page-title { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 800; }

  .faq-container { max-width: 820px; }
  .faq-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 2rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .faq-item:first-child { border-top: 1px solid var(--rule); }
  .faq-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--file-tab);
    letter-spacing: 0.04em;
    padding-top: 0.25rem;
  }
  .faq-question {
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 0.75rem;
    color: var(--ink);
  }
  .faq-answer {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-soft);
    margin: 0;
  }

  @media (max-width: 600px) {
    .faq-item { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
