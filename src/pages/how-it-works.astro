---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';

const title = 'How It Works — From Painful Process to Owned Workflow | Savoi.ai';

const steps = [
  { num: '01', phase: 'DIAGNOSE', title: 'Quick Call', duration: '30 minutes', desc: "We talk through what's eating your time. We find 1–2 things that would make the biggest difference. No commitment, no pressure." },
  { num: '02', phase: 'DIAGNOSE', title: 'Service Layer Diagnostic', duration: '2 weeks · $7,500', desc: "We map the repetitive work inside every role, name the first job an agent should own, and hand you a fixed build quote. The fee is fully credited against any build signed within 60 days. If we don't find enough to justify an agent, we tell you that instead." },
  { num: '03', phase: 'BUILD', title: 'We Build It', duration: '3–6 weeks', desc: 'We build the AI, connect it to your tools, train it on your business, and test it against real situations from your day-to-day.' },
  { num: '04', phase: 'BUILD', title: 'Launch and Train', duration: '1–2 weeks', desc: 'Your team learns how to work with the AI. We document everything and agree on what success looks like.' },
  { num: '05', phase: 'MANAGE', title: 'We Run It', duration: 'Ongoing', desc: 'This is the managed part. We monitor it, maintain it, and improve it under retainer. The AI gets better over time and our phone rings when something breaks.' },
];
---

<Base title={title} fileNo="SAVOI-006" classification="FOR PUBLIC RELEASE">
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-meta label">FILE 06 — THE PROCESS</div>
      <h1 class="page-title reveal">From Time Sink<br /><span class="page-title-accent">to Done Automatically</span></h1>
    </div>
  </section>

  <section class="section paper-texture">
    <div class="container">
      <div class="rule-label reveal"><span>§ 01 — The Steps</span></div>
      <div class="steps">
        {steps.map((step) => (
          <div class="step reveal">
            <div class="step-num-col">
              <span class="step-num">{step.num}</span>
            </div>
            <div class="step-body">
              <div class="step-header">
                <span class="step-phase label">{step.phase}</span>
                <h3 class="step-title">{step.title}</h3>
                <span class="step-duration">{step.duration}</span>
              </div>
              <p class="step-desc">{step.desc}</p>
            </div>
            <div class="step-connector"></div>
          </div>
        ))}
      </div>

      <div class="timeline reveal">
        <div class="timeline-label label">TYPICAL TIMELINE</div>
        <p class="timeline-text">
          Most projects go from first call to live in <strong>5–9 weeks</strong>,
          depending on how complex your setup is.
        </p>
      </div>
    </div>
  </section>

  <CTA
    headline="Ready to get your time back?"
    subtext="30 minutes. No commitment. We'll find 1–2 things eating your time and show you exactly what your AI employee would handle."
    fileNo="SAVOI-006 / CTA"
  />
</Base>

<style>
  .page-hero { padding: 5rem 0 4rem; }
  .page-meta { color: var(--file-tab); margin-bottom: 1rem; }
  .page-title { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 800; line-height: 1.1; }
  .page-title-accent { color: var(--classification-soft); font-style: italic; font-weight: 600; }

  .steps { margin-top: 1rem; }
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 2rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--rule);
    position: relative;
  }
  .step:first-child { border-top: 1px solid var(--rule); }
  .step-num-col { position: relative; }
  .step-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 2rem;
    font-weight: 700;
    color: var(--file-tab);
    line-height: 1;
  }
  .step-body { padding-bottom: 0.5rem; }
  .step-header { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 0.625rem; flex-wrap: wrap; }
  .step-phase { color: var(--classification); font-size: 0.6875rem; }
  .step-title { font-size: 1.25rem; margin: 0; }
  .step-duration {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--classification);
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--classification);
    border-radius: var(--radius);
  }
  .step-desc { font-size: 0.9375rem; line-height: 1.6; color: var(--ink-soft); margin: 0; max-width: 620px; }

  .timeline {
    margin-top: 3rem;
    padding: 2rem;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  .timeline-label { color: var(--file-tab); margin-bottom: 0.625rem; }
  .timeline-text { font-size: 1.125rem; line-height: 1.5; margin: 0; }
  .timeline-text strong { color: var(--classification); }

  @media (max-width: 600px) {
    .step { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
