---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';

const title = 'How It Works · From the Way Your Business Runs to a System You Own | Savoi.ai';

const steps = [
  { num: '01', phase: 'LISTEN', title: 'Quick Call', duration: '30 minutes', desc: "We talk through what is eating your team's time and what the system you wish existed would need to do, with no commitment and no pressure, and we tell you plainly if we do not think a bespoke build is the answer." },
  { num: '02', phase: 'LISTEN', title: 'Service Layer Diagnostic', duration: '2 weeks · $7,500', desc: "We sit with the people who do the work, map where their time goes, and write the requirements for the first version of the system with you, ending with a fixed scope and a fixed build quote. The fee is fully credited against any build signed within 60 days, and if we do not find enough to justify a build, we tell you that instead." },
  { num: '03', phase: 'BUILD', title: 'A Thin Working System', duration: 'Scoped in the Diagnostic', desc: 'We build a small version that runs end to end on your real work, connected to your tools and tested against real situations from your day to day, so your team can use it and push on it while changes are still easy.' },
  { num: '04', phase: 'BUILD', title: 'Scoped Steps From There', duration: 'Each step quoted first', desc: 'The system grows in steps that are each scoped, priced and agreed before they start, which might mean another workflow, another connection, or an agent built in to handle a piece of the work that needs judgment.' },
  { num: '05', phase: 'OWN', title: 'Yours to Run', duration: 'Ongoing', desc: 'You own the code, the harness that runs, tests and deploys it, and the data, so your team or anyone you choose can take it from there, and if you would rather we keep running and improving it, we offer that under a managed retainer.' },
];
---

<Base title={title} fileNo="SAVOI-006" classification="FOR PUBLIC RELEASE">
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-meta label">FILE 06 · THE PROCESS</div>
      <h1 class="page-title reveal">From How Your Business Runs<br /><span class="page-title-accent">to a System You Own</span></h1>
    </div>
  </section>

  <section class="section paper-texture">
    <div class="container">
      <div class="rule-label reveal"><span>§ 01 · The Steps</span></div>
      <div class="steps">
        {steps.map((step) => (
          <div class="step reveal">
            <div class="step-num-col">
              <span class="step-num">{step.num}</span>
            </div>
            <div class="step-body">
              <div class="step-header">
                <span class="step-phase label">{step.phase}</span>
                <h3 class="step-title">{step.title}</h3>
                <span class="step-duration">{step.duration}</span>
              </div>
              <p class="step-desc">{step.desc}</p>
            </div>
            <div class="step-connector"></div>
          </div>
        ))}
      </div>

      <div class="timeline reveal">
        <div class="timeline-label label">ON TIMELINES</div>
        <p class="timeline-text">
          We do not quote a timeline before the requirements exist, for the same reason we do not quote
          a price, but you will see working software early because the thin first version is designed
          to be small, and every step after that comes with its own scope and date before it starts.
        </p>
      </div>
    </div>
  </section>

  <CTA
    headline="Ready to scope the system you wish existed?"
    subtext="Thirty minutes, no commitment. Walk us through the work it would need to do, and we will tell you what the thin first version would look like."
    buttonLabel="Scope a Bespoke Build"
    fileNo="SAVOI-006 / CTA"
  />
</Base>

<style>
  .page-hero { padding: 5rem 0 4rem; }
  .page-meta { color: var(--file-tab); margin-bottom: 1rem; }
  .page-title { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 800; line-height: 1.1; }
  .page-title-accent { color: var(--classification-soft); font-style: italic; font-weight: 600; }

  .steps { margin-top: 1rem; }
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 2rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--rule);
    position: relative;
  }
  .step:first-child { border-top: 1px solid var(--rule); }
  .step-num-col { position: relative; }
  .step-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 2rem;
    font-weight: 700;
    color: var(--file-tab);
    line-height: 1;
  }
  .step-body { padding-bottom: 0.5rem; }
  .step-header { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 0.625rem; flex-wrap: wrap; }
  .step-phase { color: var(--classification); font-size: 0.6875rem; }
  .step-title { font-size: 1.25rem; margin: 0; }
  .step-duration {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--classification);
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--classification);
    border-radius: var(--radius);
  }
  .step-desc { font-size: 0.9375rem; line-height: 1.6; color: var(--ink-soft); margin: 0; max-width: 620px; }

  .timeline {
    margin-top: 3rem;
    padding: 2rem;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  .timeline-label { color: var(--file-tab); margin-bottom: 0.625rem; }
  .timeline-text { font-size: 1.125rem; line-height: 1.5; margin: 0; }
  .timeline-text strong { color: var(--classification); }

  @media (max-width: 600px) {
    .step { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
