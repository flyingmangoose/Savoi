---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import WorkflowDiagram from '../components/WorkflowDiagram.astro';

const title = 'Case Study — A Global Plywood Manufacturer | Savoi.ai';

const problems = [
  'Sales management ran on the CEO personally reviewing numbers and prompting his traders',
  'The weekly trader report was assembled by hand from exports',
  'Receivables got chased when someone remembered, not on a cadence',
  'The discipline only happened when leadership had time for it',
];

const deliverables = [
  { name: 'Weekly trader report', desc: 'Performance by trader, compiled from live CRM data and posted to the team channel.' },
  { name: 'Receivables review', desc: 'Aging tracked against credit limits, with what needs a human decision surfaced.' },
  { name: 'Morning briefing', desc: 'What matters today, in the channel before the desk starts trading.' },
  { name: 'Evening briefing', desc: 'What moved, what closed, what went quiet, at the end of the trading day.' },
];
---

<Base title={title} fileNo="SAVOI-003" classification="CASE FILE — VERIFIED">
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-meta label">FILE 03 — CASE FILE 002</div>
      <h1 class="page-title reveal">A Global Plywood Manufacturer</h1>
      <p class="page-subtitle reveal">
        Hardwood plywood, sold across North America<br />
        Pacific Northwest, USA
      </p>
      <div class="case-stamp-wrap">
        <span class="stamp stamp-green stamp-animate">Case Verified</span>
      </div>
    </div>
  </section>

  <!-- CLIENT FILE -->
  <section class="section paper-texture">
    <div class="container">
      <div class="rule-label reveal"><span>§ 01 — Client Dossier</span></div>
      <div class="client-grid">
        <div class="client-field reveal">
          <div class="label client-field-label">CLIENT</div>
          <div class="client-field-value">Global hardwood plywood manufacturer<br /><span class="client-anon">Name released on request. Engagement active.</span></div>
        </div>
        <div class="client-field reveal">
          <div class="label client-field-label">LOCATION</div>
          <div class="client-field-value">Pacific Northwest, USA</div>
        </div>
        <div class="client-field reveal">
          <div class="label client-field-label">AGENT SCOPE</div>
          <div class="client-field-value">Internal sales management and reporting for the trading desk. No customer-facing contact.</div>
        </div>
        <div class="client-field reveal">
          <div class="label client-field-label">COMPANY</div>
          <div class="client-field-value">A family-run trading and manufacturing business selling to distributors, manufacturers, and contractors across North America.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CHALLENGE -->
  <section class="section section-dark">
    <div class="container">
      <div class="rule-label reveal"><span>§ 02 — The Challenge</span></div>
      <div class="challenge reveal">
        <p class="challenge-text">
          The CEO had a sales management process that worked. The problem was that it
          only ran when he ran it:
        </p>
        <ul class="doc-list challenge-list">
          {problems.map((q) => <li>{q}</li>)}
        </ul>
        <p class="challenge-text">
          None of it was complicated. All of it was on one person's calendar, competing
          with running the company.
        </p>
      </div>
    </div>
  </section>

  <!-- WORKFLOW DIAGRAM -->
  <section class="section paper-texture">
    <div class="container">
      <div class="rule-label reveal"><span>§ 02.A — Data Flow</span></div>
      <div class="diagram-wrap reveal">
        <WorkflowDiagram />
      </div>
    </div>
  </section>

  <!-- SOLUTION -->
  <section class="section paper-texture">
    <div class="container">
      <div class="rule-label reveal"><span>§ 03 — The Solution</span></div>
      <div class="solution reveal">
        <p class="solution-text">
          We encoded the CEO's own sales management routine into an agent and put it on
          a machine in their office, reading their CRM live over an authenticated
          connection. It runs the routine whether or not anyone remembers to. It never
          contacts a customer. It reports to the desk:
        </p>
        <ul class="deliverable-list">
          {deliverables.map((d) => (
            <li class="deliverable">
              <span class="deliverable-name">{d.name}</span>
              <span class="deliverable-desc">{d.desc}</span>
            </li>
          ))}
        </ul>
        <p class="solution-text">
          Everything lands in the channel the team already lives in. Exceptions get
          escalated to leadership rather than buried in a report nobody opens.
        </p>
        <div class="solution-quote">
          <p class="solution-quote-text">The process stopped depending on the CEO having a free hour.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY THIS MATTERS -->
  <section class="section section-dark">
    <div class="container">
      <div class="rule-label reveal"><span>§ 04 — Why This Matters</span></div>
      <div class="matters reveal">
        <p class="matters-text">
          In most owner-led companies the sales process lives in the owner's head and
          runs at the owner's pace. It is real judgment, refined over years, and it is
          the single biggest bottleneck in the business.
        </p>
        <p class="matters-text">
          That judgment is what we encode. The agent runs on hardware the client owns,
          so the process stays theirs: inspectable, portable, and not sitting in someone
          else's cloud — <em>no chatbot involved</em>.
        </p>
      </div>
    </div>
  </section>

  <CTA
    headline="Want this for your team?"
    subtext="Book a call. We'll show you exactly what a managed agent would own in your business."
    fileNo="SAVOI-003 / CTA"
  />
</Base>

<style>
  .page-hero { padding: 5rem 0 4rem; }
  .page-meta { color: var(--file-tab); margin-bottom: 1rem; }
  .page-title { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 800; margin-bottom: 1rem; }
  .page-subtitle { font-size: 1.0625rem; color: var(--ink-faint); font-family: 'JetBrains Mono', monospace; letter-spacing: 0.02em; line-height: 1.7; }
  .case-stamp-wrap { margin-top: 2rem; }
  .diagram-wrap { max-width: 720px; margin: 0 auto; }

  .client-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 3rem;
  }
  .client-field { border-left: 2px solid var(--rule-2); padding-left: 1.25rem; }
  .client-field-label { color: var(--classification); margin-bottom: 0.5rem; }
  .client-field-value { font-size: 1rem; line-height: 1.55; }

  .challenge { max-width: 720px; }
  .challenge-text { font-size: 1.0625rem; line-height: 1.7; color: var(--paper); margin-bottom: 1.25rem; }
  .challenge-list { margin: 1.25rem 0; }

  .solution { max-width: 720px; }
  .solution-text { font-size: 1.0625rem; line-height: 1.7; margin-bottom: 1.25rem; }
  .solution-list { margin: 1.25rem 0 2rem; }
  .solution-quote {
    padding: 1rem 1.5rem;
    margin-top: 2rem;
    background: rgba(140,32,32,0.03);
    border-top: 1px solid var(--classification-faint);
    border-bottom: 1px solid var(--classification-faint);
  }
  .solution-quote-text {
    font-size: 1.25rem;
    font-style: italic;
    font-weight: 600;
    line-height: 1.4;
    margin: 0;
    color: var(--ink);
  }

  .matters { max-width: 720px; }
  .matters-text { font-size: 1.0625rem; line-height: 1.7; color: var(--paper); margin-bottom: 1.25rem; }
  .matters-text em { color: var(--classification-soft); font-weight: 600; }

  @media (max-width: 700px) {
    .client-grid { grid-template-columns: 1fr; }
  }
  .deliverable-list { list-style: none; padding: 0; margin: 1.5rem 0; }
  .deliverable { border-top: 1px solid var(--rule); padding: 1rem 0; display: grid; grid-template-columns: 200px 1fr; gap: 1.5rem; }
  .deliverable:last-child { border-bottom: 1px solid var(--rule); }
  .deliverable-name { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--classification); padding-top: 0.15rem; }
  .deliverable-desc { font-size: 0.9375rem; line-height: 1.6; color: var(--ink-soft); }
  @media (max-width: 700px) { .deliverable { grid-template-columns: 1fr; gap: 0.35rem; } }
  .client-anon { font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; color: var(--ink-muted); font-weight: 400; letter-spacing: 0.04em; }
</style>
