---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import WorkflowDiagram from '../components/WorkflowDiagram.astro';

const title = 'Case Study — A Global Plywood Manufacturer | Savoi.ai';

const problems = [
  'Product and grading expertise lived with a handful of senior people, who got interrupted all day',
  'Answering "what do we have, where, and who owns it" meant logging in and hunting',
  'Trade and tariff guidance sat in one or two heads and in old email threads',
  'Nobody was watching for the changes that quietly cost money',
];

const deliverables = [
  { name: 'House expert', desc: 'Species, grades, dimensions, grading standards, mill capabilities, and substitutions. Answers in seconds, in the channel, without interrupting a senior trader.' },
  { name: 'Live CRM lookups', desc: 'Pipeline by rep, account, or stage. Open deals and close dates. Inventory on hand by location, trader, and product. Read straight from the system, not from a stale export.' },
  { name: 'Trade and pricing context', desc: 'Tariff and trade case guidance, sourcing partner background, and margin discipline, all encoded from how the company actually decides.' },
  { name: 'Watchful alerts', desc: 'Freight rates, account reassignments, and inbound business mail, routed to the person who needs them as they happen.' },
  { name: 'Standing reports', desc: 'A recurring market report compiled and delivered every week without anyone remembering to ask.' },
];
---

<Base title={title} fileNo="SAVOI-003" classification="CASE FILE — VERIFIED">
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-meta label">FILE 03 — CASE FILE 002</div>
      <h1 class="page-title reveal">A Global Plywood Manufacturer</h1>
      <p class="page-subtitle reveal">
        Hardwood plywood, sold across North America<br />
        Pacific Northwest, USA
      </p>
      <div class="case-stamp-wrap">
        <span class="stamp stamp-green stamp-animate">Case Verified</span>
      </div>
    </div>
  </section>

  <!-- CLIENT FILE -->
  <section class="section paper-texture">
    <div class="container">
      <div class="rule-label reveal"><span>§ 01 — Client Dossier</span></div>
      <div class="client-grid">
        <div class="client-field reveal">
          <div class="label client-field-label">CLIENT</div>
          <div class="client-field-value">Global hardwood plywood manufacturer<br /><span class="client-anon">Name released on request. Engagement active.</span></div>
        </div>
        <div class="client-field reveal">
          <div class="label client-field-label">LOCATION</div>
          <div class="client-field-value">Pacific Northwest, USA</div>
        </div>
        <div class="client-field reveal">
          <div class="label client-field-label">AGENT SCOPE</div>
          <div class="client-field-value">Internal sales management and reporting for the trading desk. No customer-facing contact.</div>
        </div>
        <div class="client-field reveal">
          <div class="label client-field-label">COMPANY</div>
          <div class="client-field-value">A family-run trading and manufacturing business selling to distributors, manufacturers, and contractors across North America.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CHALLENGE -->
  <section class="section section-dark">
    <div class="container">
      <div class="rule-label reveal"><span>§ 02 — The Challenge</span></div>
      <div class="challenge reveal">
        <p class="challenge-text">
          The company had deep expertise and good systems. What it did not have was a
          way to get at either one quickly:
        </p>
        <ul class="doc-list challenge-list">
          {problems.map((q) => <li>{q}</li>)}
        </ul>
        <p class="challenge-text">
          A trading desk runs on answers. Every minute spent finding one is a minute not
          spent selling, and the people with the answers were the people who could least
          afford the interruption.
        </p>
      </div>
    </div>
  </section>

  <!-- WORKFLOW DIAGRAM -->
  <section class="section paper-texture">
    <div class="container">
      <div class="rule-label reveal"><span>§ 02.A — Data Flow</span></div>
      <div class="diagram-wrap reveal">
        <WorkflowDiagram />
      </div>
    </div>
  </section>

  <!-- SOLUTION -->
  <section class="section paper-texture">
    <div class="container">
      <div class="rule-label reveal"><span>§ 03 — The Solution</span></div>
      <div class="solution reveal">
        <p class="solution-text">
          We built an agent that holds the company's own expertise and reads its systems
          live, then put it in the chat channel the desk already works in. It runs on a
          machine in their building with read-only access to the CRM, inventory, and
          mailbox. It never contacts a customer. It works for the traders:
        </p>
        <ul class="deliverable-list">
          {deliverables.map((d) => (
            <li class="deliverable">
              <span class="deliverable-name">{d.name}</span>
              <span class="deliverable-desc">{d.desc}</span>
            </li>
          ))}
        </ul>
        <p class="solution-text">
          Ask it a question and it answers. Leave it alone and it watches. When something
          needs a person, it goes to that specific person rather than into a report
          nobody opens.
        </p>
        <div class="solution-quote">
          <p class="solution-quote-text">The company's expertise stopped being a calendar problem.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- UNDER THE HOOD -->
  <section class="section paper-texture">
    <div class="container">
      <div class="rule-label reveal"><span>§ 03.A — Under the Hood</span></div>
      <div class="hood-grid">
        <div class="hood reveal">
          <div class="hood-k label">WHERE IT RUNS</div>
          <div class="hood-v">A dedicated machine at the client's own site, running as a system service. No agent workload in a third-party cloud.</div>
        </div>
        <div class="hood reveal">
          <div class="hood-k label">WHAT IT READS</div>
          <div class="hood-v">The CRM and inventory system over an authenticated connection, the shared mailbox, and a curated library of the company's own product and trade knowledge.</div>
        </div>
        <div class="hood reveal">
          <div class="hood-k label">ACCESS POSTURE</div>
          <div class="hood-v">Read-only across every connected system. The agent informs decisions; it does not change the record.</div>
        </div>
        <div class="hood reveal">
          <div class="hood-k label">HOW IT SCALES</div>
          <div class="hood-v">It keeps a working memory of standing instructions and daily context, and hands heavier analysis to purpose-built sub-agents so routine lookups stay fast and cheap.</div>
        </div>
      </div>
      <p class="hood-note reveal">
        Phase two is in build: a sales management layer covering rep coaching, cadence
        discipline, and daily briefings to the desk.
      </p>
    </div>
  </section>

  <!-- WHY THIS MATTERS -->
  <section class="section section-dark">
    <div class="container">
      <div class="rule-label reveal"><span>§ 04 — Why This Matters</span></div>
      <h2 class="matters-headline reveal">This company's edge is<br /><span class="matters-accent">now written down.</span></h2>
      <div class="matters reveal">
        <p class="matters-text">
          Which mills can actually hit a spec and which ones only say they can. How to
          read a trade case before it moves a price. Which substitution a particular
          customer will accept and which one loses the order. What margin to hold and
          when to walk. Decades of judgment, and the reason they win business their
          competitors do not.
        </p>
        <p class="matters-text">
          All of it is now encoded, which is exactly why it runs on a machine in their
          building rather than in a vendor's cloud. The knowledge base is on their disk,
          in files they can open. Every connection uses their own credentials, read-only.
          <em>The day this engagement ends, everything it learned stays where it is.</em>
        </p>
        <p class="matters-link-line">
          <a href="/#sovereignty-note">More on why custody matters →</a>
        </p>
      </div>
    </div>
  </section>

  <CTA
    headline="Want this for your team?"
    subtext="Book a call. We'll show you exactly what a managed agent would own in your business."
    fileNo="SAVOI-003 / CTA"
  />
</Base>

<style>
  .page-hero { padding: 5rem 0 4rem; }
  .page-meta { color: var(--file-tab); margin-bottom: 1rem; }
  .page-title { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 800; margin-bottom: 1rem; }
  .page-subtitle { font-size: 1.0625rem; color: var(--ink-faint); font-family: 'JetBrains Mono', monospace; letter-spacing: 0.02em; line-height: 1.7; }
  .case-stamp-wrap { margin-top: 2rem; }
  .diagram-wrap { max-width: 720px; margin: 0 auto; }

  .client-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 3rem;
  }
  .client-field { border-left: 2px solid var(--rule-2); padding-left: 1.25rem; }
  .client-field-label { color: var(--classification); margin-bottom: 0.5rem; }
  .client-field-value { font-size: 1rem; line-height: 1.55; }

  .challenge { max-width: 720px; }
  .challenge-text { font-size: 1.0625rem; line-height: 1.7; color: var(--paper); margin-bottom: 1.25rem; }
  .challenge-list { margin: 1.25rem 0; }

  .solution { max-width: 720px; }
  .solution-text { font-size: 1.0625rem; line-height: 1.7; margin-bottom: 1.25rem; }
  .solution-list { margin: 1.25rem 0 2rem; }
  .solution-quote {
    padding: 1rem 1.5rem;
    margin-top: 2rem;
    background: rgba(140,32,32,0.03);
    border-top: 1px solid var(--classification-faint);
    border-bottom: 1px solid var(--classification-faint);
  }
  .solution-quote-text {
    font-size: 1.25rem;
    font-style: italic;
    font-weight: 600;
    line-height: 1.4;
    margin: 0;
    color: var(--ink);
  }

  .matters { max-width: 720px; }
  .matters-text { font-size: 1.0625rem; line-height: 1.7; color: var(--paper); margin-bottom: 1.25rem; }
  .matters-text em { color: var(--classification-soft); font-weight: 600; }

  @media (max-width: 700px) {
    .client-grid { grid-template-columns: 1fr; }
  }
  .matters-link-line { font-family: 'JetBrains Mono', monospace; font-size: 0.8125rem; margin-top: 1.5rem; }
  .matters-headline { font-size: clamp(1.75rem, 3.5vw, 2.75rem); font-weight: 700; line-height: 1.12; margin: 1.5rem 0 1.75rem; }
  .matters-accent { color: var(--classification-soft); font-style: italic; }
  .hood-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem 3rem; margin-top: 1.5rem; }
  .hood-k { color: var(--classification); margin-bottom: 0.5rem; }
  .hood-v { font-size: 0.9375rem; line-height: 1.65; color: var(--ink-soft); }
  .hood-note { margin-top: 2.5rem; padding-left: 1.25rem; border-left: 2px solid var(--rule); font-size: 0.875rem; font-family: 'JetBrains Mono', monospace; line-height: 1.6; color: var(--ink-muted); max-width: 620px; }
  @media (max-width: 760px) { .hood-grid { grid-template-columns: 1fr; gap: 1.5rem; } }
  .deliverable-list { list-style: none; padding: 0; margin: 1.5rem 0; }
  .deliverable { border-top: 1px solid var(--rule); padding: 1rem 0; display: grid; grid-template-columns: 200px 1fr; gap: 1.5rem; }
  .deliverable:last-child { border-bottom: 1px solid var(--rule); }
  .deliverable-name { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--classification); padding-top: 0.15rem; }
  .deliverable-desc { font-size: 0.9375rem; line-height: 1.6; color: var(--ink-soft); }
  @media (max-width: 700px) { .deliverable { grid-template-columns: 1fr; gap: 0.35rem; } }
  .client-anon { font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; color: var(--ink-muted); font-weight: 400; letter-spacing: 0.04em; }
</style>
